{
  "name": "binary-gv-concrete-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "validate:data": "node ../scripts/validate-data.mjs",
    "validate:math": "node scripts/validate-math.mjs",
    "build": "pnpm validate:data && pnpm validate:math && tsc -b && vite build",
    "build:pages": "pnpm validate:data && pnpm validate:math && tsc -b && vite build --mode pages",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "katex": "^0.18.7",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-katex": "^3.1.0",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-katex": "^3.0.4",
    "typescript": "5.9.3"
  }
}
